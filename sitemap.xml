---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {% assign sitemap_base = site.url | default: "https://debbyx3.github.io" %}

  {% for page in site.pages %}
    {% unless page.sitemap == false or page.url contains '/404' %}
  <url>
    <loc>{{ sitemap_base }}{{ page.url | relative_url }}</loc>
    <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
  </url>
    {% endunless %}
  {% endfor %}

  {% for doc in site.documents %}
    {% if doc.output == true and doc.sitemap != false %}
  <url>
    <loc>{{ sitemap_base }}{{ doc.url | relative_url }}</loc>
    <lastmod>{{ doc.date | default: site.time | date_to_xmlschema }}</lastmod>
  </url>
    {% endif %}
  {% endfor %}
</urlset>
